{
  "name": "@fedresda/server",
  "version": "0.0.1-alpha.4",
  "description": "FedResDa Pod: Community Solid Server for Federated Research Data",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch config --ext ts,json --exec \"npm run build && npm run start\"",
    "start": "node ../node_modules/@solid/community-server/bin/server.js -c ./config/config.json -m ./ -f ../data -s http://localhost:8889/bigdata/sparql",
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc -p tsconfig.json",
    "build:components": "componentsjs-generator -s src -c dist/components -r fss -i .componentsignore",
    "test:schema-migration": "ts-node ./scripts/test-schema-migration.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SetMeld/fedresda-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SetMeld/fedresda-node/issues"
  },
  "homepage": "https://github.com/SetMeld/fedresda-node#readme",
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/express": "^5.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/multer": "^1.4.12",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "componentsjs-generator": "^4.3.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@fedresda/types": "*",
    "@ldo/connected-solid": "^1.0.0-alpha.28",
    "@solid/access-token-verifier": "^2.1.0",
    "@solid/community-server": "^8.0.0-alpha.0",
    "@tpluscode/sparql-builder": "^3.0.1",
    "body-parser": "^2.2.0",
    "componentsjs": "^6.3.0",
    "express": "^5.1.0",
    "express-remove-route": "^1.0.0",
    "fetch-sparql-endpoint": "^7.1.0",
    "json-schema": "^0.4.0",
    "multer": "^1.4.5-lts.2",
    "rdf-sparql-builder": "^0.2.5",
    "yup": "^1.6.1"
  },
  "types": "./dist/index.d.ts",
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@fedresda/server/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@fedresda/server/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@fedresda/server/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@fedresda/server/^0.0.0/dist/": "dist/"
  }
}
