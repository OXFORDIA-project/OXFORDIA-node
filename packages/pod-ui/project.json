{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pod-ui",
  "projectType": "library",
  "sourceRoot": "packages/pod-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npm run build"
      }
    },
    "build-server-ui": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist-server"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "npm run build:server"
      }
    }
  }
}
