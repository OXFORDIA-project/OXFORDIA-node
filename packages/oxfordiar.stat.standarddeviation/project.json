{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "oxfordiar-stat-standarddeviation",
  "projectType": "library",
  "sourceRoot": "packages/oxfordiar.stat.standarddeviation/R",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "mkdir -p dist && R CMD build . --no-build-vignettes --no-manual && mv oxfordiar.stat.standarddeviation_*.tar.gz dist/"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "Rscript scripts/test.R"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "Rscript scripts/lint-r.R packages/oxfordiar.stat.standarddeviation"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "Rscript scripts/format-r.R packages/oxfordiar.stat.standarddeviation"
      }
    }
  }
}
