# Copy this file to `packages/oxfordia-client/.env` and fill in real values.
# You can also point the smoke test at another file with `OX_ENV_FILE=/path/to/file`.
# Install dependencies first with `Rscript packages/oxfordia-client/scripts/install-deps.R`.

# Shared query settings
OX_STAT=mean
OX_DATA_SCHEMA=nemaline
OX_SHORTCUT=BaselineAge
# OX_TIME_SHORTCUT=KaplanMeierTime
# OX_EVENT_SHORTCUT=KaplanMeierEvent
# OX_GROUP_SHORTCUT=ClusterCategory
# OX_API_PATH=/.api/stat

# Global authentication
OX_SOLID_ISSUER=https://solid-idp.example.org
OX_SOLID_CLIENT_ID=replace-with-client-id
OX_SOLID_CLIENT_SECRET=replace-with-client-secret
# OX_BEARER_TOKEN=replace-with-token

# Indexed targets
# Even a one-target run should use `OX_TARGET_1_*`.
#
# OX_TARGET_1_SERVER_NAME=site_a
# OX_TARGET_1_RESOURCE_URI=https://pod-a.example.org/alice/data.ttl
#
# OX_TARGET_2_SERVER_NAME=site_b
# OX_TARGET_2_RESOURCE_URI=https://pod-b.example.org/bob/data.ttl

# Optional server override entries.
# Use these only when an API origin differs from the resource origin.
#
# OX_SERVER_1_NAME=site_a
# OX_SERVER_1_URL=https://api-a.example.org
# OX_SERVER_2_NAME=site_b
# OX_SERVER_2_URL=https://api-b.example.org
