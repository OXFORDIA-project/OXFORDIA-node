Package: oxfordiaClient
Type: Package
Title: Federated Oxfordia Client
Version: 0.0.0.9000
Description: Federated R client for Oxfordia statistic queries across
    multiple servers using pluggable data-plugin shortcut catalogs,
    statistic-plugin query descriptors, and solidauthr-backed Solid
    authentication.
Authors@R: person(
    "OXFORDIA Project",
    email = "opensource@oxfordia.invalid",
    role = c("aut", "cre")
  )
License: MIT
Encoding: UTF-8
Depends:
    R (>= 4.1.0)
Imports:
    httr2,
    jsonlite,
    solidauthr
