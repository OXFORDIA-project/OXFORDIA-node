{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "oxfordia-client",
  "projectType": "library",
  "sourceRoot": "packages/oxfordia-client/R",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "mkdir -p dist && R CMD build . --no-build-vignettes --no-manual && mv oxfordiaClient_*.tar.gz dist/"
      }
    },
    "smoke-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "Rscript packages/oxfordia-client/scripts/smoke-test.R"
      }
    }
  }
}
