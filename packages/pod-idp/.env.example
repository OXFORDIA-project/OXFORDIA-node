# Public HTTPS URL for the single CSS server.
# Keep this aligned with DOMAIN and prefer a trailing slash.
CSS_BASE_URL=https://solid-idp.university.edu/

# Public DNS name served by Caddy.
DOMAIN=solid-idp.university.edu

# Let's Encrypt contact address.
ACME_EMAIL=admin@university.edu

# Public listener ports for the reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: local loopback port for diagnostics and integration tests.
IDP_LOCAL_PORT=3300

# Optional: CSS listen port inside the container network.
IDP_INTERNAL_PORT=3000

# Optional: pin the CSS image once you validate a specific release.
CSS_IMAGE=solidproject/community-server:latest
