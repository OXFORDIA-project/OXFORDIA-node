# Copy this file to `packages/oxfordiar/.env` and fill in real values.
# You can also point the smoke test at another file with `OX_ENV_FILE=/path/to/file`.
# Install dependencies first with `Rscript packages/oxfordiar/scripts/install-deps.R`.
# Run the env-driven smoke test with `Rscript packages/oxfordiar/scripts/smoke-test.R`.
# This file uses standard `readRenviron()` syntax: `NAME=value`, comments, and quoted values.

# Mean query
OX_MEAN_SHORTCUT=BaselineAge

# Kaplan-Meier query
OX_KAPLAN_MEIER_TIME_SHORTCUT=KaplanMeierTime
OX_KAPLAN_MEIER_EVENT_SHORTCUT=KaplanMeierEvent
OX_KAPLAN_MEIER_GROUP_SHORTCUT=ClusterCategory

# Solid authentication
OX_SOLID_ISSUER=https://solid-idp.example.org
OX_SOLID_CLIENT_ID=replace-with-client-id
OX_SOLID_CLIENT_SECRET=replace-with-client-secret

# Smoke targets
OX_TARGET_1_SERVER_NAME=site_a
OX_TARGET_1_RESOURCE_URI=https://pod-a.example.org/alice/data.ttl

OX_TARGET_2_SERVER_NAME=site_b
OX_TARGET_2_RESOURCE_URI=https://pod-b.example.org/bob/data.ttl

OX_TARGET_3_SERVER_NAME=site_c
OX_TARGET_3_RESOURCE_URI=https://pod-c.example.org/charlie/data.ttl
