# ─── PedsQL Adult Quality of Life Inventory ──────────────────────────────────
# REDCap form: pedsql_adult_quality_of_life_inventory
# Age band selected via age_calculate checkbox (multi-select):
#   2  → Parent Report for Adults          (columns adult_107–129)
#   4  → Parent Report for Young Adults 18–25 (columns adult_137–159)
#   6  → Parent Report for Teens 13–18    (columns adult_166–188)
#   8  → Parent Report for Children 8–12  (columns adult_193–215)
#   10 → Parent Report for Young Children 5–7 (columns adult_340–363)
#   11 → Parent Report for Toddlers 2–4   (columns adult_77–97)
# Each band covers Physical, Emotional, Social, and School/Work subscales.
# Items scored 0–4: 0=Never to 4=Almost Always.
# The REDCap column number is used as the aspect identifier for each item.

ag:PedsQLAdultResult
{
  a [gist:Content] ;
  gist:isAbout [ag:Concept_AdultQoL] ?
    // rdfs:label "Instrument concept"
    // rdfs:comment "PedsQL QoL instrument, age-banded parent-reported form" ;
  gist:isCategorizedBy [
    ag:AgeBand_2to4
    ag:AgeBand_5to7
    ag:AgeBand_8to12
    ag:AgeBand_13to17
    ag:AgeBand_18to25
    ag:AgeBand_26Plus
  ] ?
    // rdfs:label "Age Band"
    // rdfs:comment "PedsQL age band determining which item set applies (REDCap: age_calculate). 2=Toddlers 2-4, 11=Young Children 5-7, 10=Children 8-12, 8=Teens 13-18, 4=Young Adults 18-25, 2=Adults 26+" ;
  gist:hasMagnitude @ag:AdultItemMagnitude *
    // rdfs:label "QoL Item Response"
    // rdfs:comment "A single item response from the age-appropriate PedsQL subscale. The aspect IRI encodes the REDCap column number (e.g. ag:Aspect_Adult_Q107). Items scored 0–4." ;
}
// rdfs:label "PedsQL Quality of Life Inventory (parent-reported, age-banded)"
// rdfs:comment "PedsQL age-banded Quality of Life Inventory, parent-reported, covering Physical Functioning, Emotional Functioning, Social Functioning, and School/Work Functioning. Age band is selected by the age_calculate checkbox field."

ag:AdultItemMagnitude
{
  a [gist:Magnitude] ;
  gist:hasAspect [
    # ── Adults (age_calculate___2, REDCap: adult_107–129) ──────────────────
    ag:Aspect_Adult_Q107  # Walking more than 100m (Physical)
    ag:Aspect_Adult_Q108  # Running (Physical)
    ag:Aspect_Adult_Q109  # Participating in sports activity or exercise (Physical)
    ag:Aspect_Adult_Q110  # Lifting something heavy (Physical)
    ag:Aspect_Adult_Q111  # Doing chores around the house (Physical)
    ag:Aspect_Adult_Q112  # Feel afraid or scared (Emotional)
    ag:Aspect_Adult_Q113  # Feel sad (Emotional)
    ag:Aspect_Adult_Q114  # Feel angry (Emotional)
    ag:Aspect_Adult_Q115  # Worrying about what will happen to him or her (Emotional)
    ag:Aspect_Adult_Q116  # Getting along with other adults (Social)
    ag:Aspect_Adult_Q117  # Other adults not wanting to be his or her friend (Social)
    ag:Aspect_Adult_Q118  # Getting teased by other adults (Social)
    ag:Aspect_Adult_Q119  # Hard to pay attention at work or school (Work/Studies)
    ag:Aspect_Adult_Q120  # Forgetting things (Work/Studies)
    ag:Aspect_Adult_Q121  # Taking a bath or shower by him or herself (Physical)
    ag:Aspect_Adult_Q122  # Having aches or pains (Physical)
    ag:Aspect_Adult_Q123  # Feeling tired (Physical)
    ag:Aspect_Adult_Q124  # Trouble sleeping (Emotional)
    ag:Aspect_Adult_Q125  # Not able to do things that others his or her age can do (Social)
    ag:Aspect_Adult_Q126  # Keeping up with other adults (Social)
    ag:Aspect_Adult_Q127  # Keeping up with work or studies (Work/Studies)
    ag:Aspect_Adult_Q128  # Missing work/college because of not feeling well (Work/Studies)
    ag:Aspect_Adult_Q129  # Missing work/college to go to the doctor or hospital (Work/Studies)
    # ── Young Adults 18–25 (age_calculate___4, REDCap: adult_137–159) ──────
    ag:Aspect_Adult_Q137  # Walking more than 100m (Physical)
    ag:Aspect_Adult_Q138  # Running (Physical)
    ag:Aspect_Adult_Q139  # Participating in sports activity or exercise (Physical)
    ag:Aspect_Adult_Q140  # Lifting something heavy (Physical)
    ag:Aspect_Adult_Q141  # Doing chores around the house (Physical)
    ag:Aspect_Adult_Q142  # Feel afraid or scared (Emotional)
    ag:Aspect_Adult_Q143  # Feel sad or blue (Emotional)
    ag:Aspect_Adult_Q144  # Feel angry (Emotional)
    ag:Aspect_Adult_Q145  # Worrying about what will happen to him or her (Emotional)
    ag:Aspect_Adult_Q146  # Getting along with other young adults (Social)
    ag:Aspect_Adult_Q147  # Other young adults not wanting to be his or her friend (Social)
    ag:Aspect_Adult_Q148  # Getting teased by other young adults (Social)
    ag:Aspect_Adult_Q149  # Paying attention at work or school (Work/Studies)
    ag:Aspect_Adult_Q150  # Forgetting things (Work/Studies)
    ag:Aspect_Adult_Q151  # Keeping up with work or studies (Work/Studies)
    ag:Aspect_Adult_Q152  # Taking a bath or shower by him or herself (Physical)
    ag:Aspect_Adult_Q153  # Having aches or pains (Physical)
    ag:Aspect_Adult_Q154  # Feeling tired (Physical)
    ag:Aspect_Adult_Q155  # Missing work/college because of not feeling well (Work/Studies)
    ag:Aspect_Adult_Q156  # Missing work/college to go to the doctor or hospital (Work/Studies)
    ag:Aspect_Adult_Q157  # Trouble sleeping (Emotional)
    ag:Aspect_Adult_Q158  # Not able to do things that others his or her age can do (Social)
    ag:Aspect_Adult_Q159  # Keeping up with other adults (Social)
    # ── Teens 13–18 (age_calculate___6, REDCap: adult_166–188) ─────────────
    ag:Aspect_Adult_Q166  # Walking more than 100m (Physical)
    ag:Aspect_Adult_Q167  # Running (Physical)
    ag:Aspect_Adult_Q168  # Participating in sports activity or exercise (Physical)
    ag:Aspect_Adult_Q169  # Lifting something heavy (Physical)
    ag:Aspect_Adult_Q170  # Having aches or pains (Physical)
    ag:Aspect_Adult_Q171  # Feel afraid or scared (Emotional)
    ag:Aspect_Adult_Q172  # Feel sad or blue (Emotional)
    ag:Aspect_Adult_Q173  # Feel angry (Emotional)
    ag:Aspect_Adult_Q174  # Worry about what will happen to him or her (Emotional)
    ag:Aspect_Adult_Q175  # Getting along with other teens (Social)
    ag:Aspect_Adult_Q176  # Other teens not wanting to be his or her friend (Social)
    ag:Aspect_Adult_Q177  # Getting teased by other teens (Social)
    ag:Aspect_Adult_Q178  # Paying attention in class (School)
    ag:Aspect_Adult_Q179  # Forgetting things (School)
    ag:Aspect_Adult_Q180  # Keeping up with schoolwork (School)
    ag:Aspect_Adult_Q181  # Taking a bath or shower by him or herself (Physical)
    ag:Aspect_Adult_Q182  # Doing chores around the house (Physical)
    ag:Aspect_Adult_Q183  # Feeling tired (Physical)
    ag:Aspect_Adult_Q184  # Trouble sleeping (Emotional)
    ag:Aspect_Adult_Q185  # Not able to do things that others his or her age can do (Social)
    ag:Aspect_Adult_Q186  # Keeping up with other teenagers (Social)
    ag:Aspect_Adult_Q187  # Missing school to go to the doctor or hospital (School)
    ag:Aspect_Adult_Q188  # Missing school because of not feeling well (School)
    # ── Children 8–12 (age_calculate___8, REDCap: adult_193–215) ───────────
    ag:Aspect_Adult_Q193  # Walking more than 100m (Physical)
    ag:Aspect_Adult_Q194  # Running (Physical)
    ag:Aspect_Adult_Q195  # Participating in sports activity or exercise (Physical)
    ag:Aspect_Adult_Q196  # Lifting something heavy (Physical)
    ag:Aspect_Adult_Q197  # Doing chores around the house (Physical)
    ag:Aspect_Adult_Q198  # Feel afraid or scared (Emotional)
    ag:Aspect_Adult_Q199  # Feel sad or blue (Emotional)
    ag:Aspect_Adult_Q200  # Feel angry (Emotional)
