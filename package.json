{
  "name": "oxfordia-monorepo",
  "version": "0.0.1-alpha.4",
  "description": "OXFORDIA Nx monorepo",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "build": "nx run-many -t build --all --parallel=3",
    "typecheck": "tsc -b --pretty false",
    "build:server:packages": "tsc -b packages/pod-server/tsconfig.json --pretty false",
    "build:ui:packages": "tsc -b packages/pod-ui/tsconfig.json --pretty false",
    "watch:server:packages": "tsc -b packages/pod-server/tsconfig.json --watch --preserveWatchOutput",
    "watch:ui:packages": "tsc -b packages/pod-ui/tsconfig.json --watch --preserveWatchOutput",
    "dev:server": "npm run build:server:packages && concurrently -n server-types,server-host \"npm run watch:server:packages\" \"npm --prefix packages/pod-server run dev\"",
    "dev:multiple": "npm run build:server:packages && bash ./scripts/dev-multiple.sh",
    "dev:ui": "npm run build:ui:packages && concurrently -n ui-types,ui-host \"npm run watch:ui:packages\" \"npm --prefix packages/pod-ui run build:server:watch\"",
    "dev": "npm run build:server:packages && npm run build:ui:packages && concurrently -n server-types,server-host,ui-types,ui-host \"npm run watch:server:packages\" \"npm --prefix packages/pod-server run dev\" \"npm run watch:ui:packages\" \"npm --prefix packages/pod-ui run build:server:watch\"",
    "start:server": "npm --prefix packages/pod-server run start",
    "build:server": "npm run build:server:packages && npm --prefix packages/pod-server run build",
    "build:ui": "npm run build:ui:packages && npm --prefix packages/pod-ui run build:server",
    "deploy:package": "npm run build && node scripts/create-deploy-package.js",
    "version:get": "bash ./scripts/version.sh get",
    "version:set": "bash ./scripts/version.sh set",
    "version:bump": "bash ./scripts/version.sh bump"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OXFORDIA-project/OXFORDIA-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OXFORDIA-project/OXFORDIA-node/issues"
  },
  "homepage": "https://github.com/OXFORDIA-project/OXFORDIA-node#readme",
  "devDependencies": {
    "@ldo/cli": "^1.0.0-alpha.38",
    "@tsconfig/node18": "^18.2.4",
    "@types/express": "^5.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "componentsjs-generator": "^4.3.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "nx": "^20.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {}
}
