{
  "name": "oxfordia-monorepo",
  "version": "0.0.1-alpha.7",
  "description": "OXFORDIA Nx monorepo",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "act:list": "act -l",
    "act:next": "act push -e .github/act/push-next.json -j build --secret-file .secrets",
    "act:release": "act push -e .github/act/push-tag.json -j build --secret-file .secrets",
    "act:validate": "act pull_request -j validate",
    "build": "nx run-many -t build --all --parallel=3",
    "build:deb": "bash deploy/deb/build-deb.sh",
    "build:deb:idp": "bash deploy/deb/build-idp-deb.sh",
    "build:docker": "docker build -t ghcr.io/oxfordia-project/oxfordia-node:local .",
    "build:server": "npm run build:server:types && npm --prefix packages/pod-server run build",
    "build:server:types": "tsc -b packages/pod-server/tsconfig.json --pretty false --force",
    "build:ui": "npm run build:ui:types && npm --prefix packages/pod-ui run build:server",
    "build:ui:types": "tsc -b packages/pod-ui/tsconfig.json --pretty false --force",
    "check:types": "npm run build:server:types && npm run build:ui:types && tsc -b --pretty false",
    "dev": "bash ./scripts/dev.sh",
    "dev:pods": "tsc -b packages/pod-server/tsconfig.json --pretty false && bash ./scripts/dev-multiple.sh",
    "dev:server": "bash ./scripts/dev.sh server",
    "dev:ui": "bash ./scripts/dev.sh",
    "format:r": "Rscript scripts/format-r.R",
    "format:r:check": "Rscript scripts/format-r.R --check",
    "graph": "nx graph",
    "lint:r": "Rscript scripts/lint-r.R",
    "nx": "nx",
    "postinstall": "patch-package",
    "release:r:checklist": "Rscript scripts/release-r-checklist.R",
    "release:r:preflight": "Rscript scripts/release-r-preflight.R",
    "release:r": "bash ./scripts/release-r.sh",
    "release:r:winbuilder": "Rscript scripts/release-r-winbuilder.R",
    "start:server": "npm --prefix packages/pod-server run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deb": "bash ./scripts/test-deb.sh",
    "watch:server:types": "tsc -b packages/pod-server/tsconfig.json --watch --preserveWatchOutput",
    "watch:ui:types": "tsc -b packages/pod-ui/tsconfig.json --watch --preserveWatchOutput",
    "version:get": "bash ./scripts/version.sh get",
    "version:set": "bash ./scripts/version.sh set",
    "version:bump": "bash ./scripts/version.sh bump",
    "version:check": "bash ./scripts/version.sh check"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OXFORDIA-project/OXFORDIA-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OXFORDIA-project/OXFORDIA-node/issues"
  },
  "homepage": "https://github.com/OXFORDIA-project/OXFORDIA-node#readme",
  "devDependencies": {
    "@ldo/cli": "^1.0.0-alpha.38",
    "@tsconfig/node18": "^18.2.4",
    "@types/express": "^5.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "@vitest/coverage-v8": "^4.1.5",
    "componentsjs-generator": "^4.3.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.9",
    "nx": "^20.8.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@simple-table/react": "^3.6.3"
  }
}
